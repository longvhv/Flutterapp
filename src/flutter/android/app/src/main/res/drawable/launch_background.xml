<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#3B82F6"
                android:centerColor="#9333EA"
                android:endColor="#EC4899"
                android:type="linear" />
        </shape>
    </item>
    
